# Repository-wide line ending enforcement (supersedes local core.autocrlf)
# - Auto-detect text vs binary files
# - Normalise text files to LF on commit and keep LF on checkout
* text=auto eol=lf
# Producer payloads and finite historical oracles retain their exact identified bytes.
native/prebuilt/** -text
# Publisher-owned license copies follow the root license's canonical text bytes.
native/prebuilt/linux-x64/LICENSE text eol=lf
native/prebuilt/win32-x64/LICENSE text eol=lf
tests/oracles/finite-v1/** -text
# Official Unicode conformance data and its notice retain the upstream bytes.
tests/fixtures/unicode/NormalizationTest-18.0.0.txt -text
tests/fixtures/unicode/LICENSE.txt -text
