{
  "name": "@hadden-industries/json-quality",
  "version": "1.0.0",
  "description": "Zero-config strict JSON/JSONL checking, single-document JSON formatting, duplicate-key detection, numeric safety and Unicode NFC repair",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.1 <13",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hadden-Industries/json-quality.git"
  },
  "homepage": "https://github.com/Hadden-Industries/json-quality#readme",
  "bugs": {
    "url": "https://github.com/Hadden-Industries/json-quality/issues"
  },
  "keywords": [
    "json",
    "jsonl",
    "ndjson",
    "formatter",
    "linter",
    "unicode",
    "nfc",
    "normalization",
    "duplicate-keys",
    "numeric-precision",
    "streaming",
    "eslint",
    "nodejs",
    "cli"
  ],
  "bin": {
    "json-quality": "src/cli.js",
    "json-quality-qualify-git": "src/qualification-cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./eslint": {
      "types": "./types/eslint/index.d.ts",
      "import": "./src/eslint/index.js"
    },
    "./configuration-schema": "./schemas/configuration.schema.json",
    "./source-contract-schema": "./schemas/source-contract.schema.json",
    "./event-schema": "./schemas/event.schema.json",
    "./contract-cohort": "./schemas/contract-cohort.json",
    "./effective-policy-schema": "./schemas/effective-policy.schema.json"
  },
  "files": [
    "src/",
    "types/",
    "schemas/",
    "assets/native-packages.json",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "docs/consumer-guide.md",
    "docs/centralized-contracts.md",
    "docs/node-runtime-compatibility.md",
    "docs/architecture.md",
    "docs/ci-trust.md",
    "docs/resource-limits.md",
    "docs/native-protocol.md",
    "docs/README.md",
    "docs/api.md",
    "docs/cli.md",
    "docs/configuration.md",
    "docs/dependency-graph-and-tests.md",
    "docs/javascript-performance.md",
    "docs/markdown-quality.md",
    "docs/release-operations.md",
    "docs/rules/",
    "examples/",
    "assets/default-json-quality-policy.json",
    "assets/json-quality-policy-inputs.json"
  ],
  "types": "./types/index.d.ts",
  "scripts": {
    "generate:dependency-graphs": "node scripts/dependency-graph.js",
    "test:contracts-and-identity": "node --test tests/contracts.test.js tests/identity.test.js",
    "benchmark:json-checking": "node scripts/bench-orchestration.js --workload check --files 30",
    "benchmark:json-formatting": "node scripts/bench-orchestration.js --workload format --files 50 --assert-batching",
    "benchmark:orchestration": "npm run benchmark:json-checking && npm run benchmark:json-formatting",
    "test": "node --test --test-concurrency=1 tests/*.test.js tests/native/*.test.mjs",
    "test:affected": "node scripts/affected-tests.js",
    "check:repository": "npm run check:version && npm run check:node-support && npm run check:workflow-contracts && npm run check:event-resources && npm run check:architecture && npm run check:public-schemas && npm run check:policy-inputs && npm run check:types && npm run check:types:generated && npm run check:shipment && npm run check:package-contracts && npm run audit:dependencies && npm test && npm run lint:javascript && npm run check:code-formatting-and-markdown && npm run qualify:package && npm run check:json",
    "check:version": "node scripts/project-package-version.js --check",
    "sync:version": "node scripts/project-package-version.js --write",
    "check:public-schemas": "node scripts/check-schemas.js",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "build:types": "node scripts/build-types.js",
    "check:types:generated": "node scripts/build-types.js --check",
    "check:package-contracts": "node scripts/check-package.js",
    "check:event-resources": "node scripts/project-resource-limits.js",
    "sync:event-resources": "node scripts/project-resource-limits.js --write",
    "check:shipment": "node scripts/release-check.js",
    "check:architecture": "node scripts/check-architecture.js",
    "sync:node-support": "node scripts/project-node-support.js --write",
    "check:node-support": "node scripts/project-node-support.js --check",
    "resolve:node-matrix": "node scripts/node-matrix.js",
    "emit:node-matrix": "node scripts/ci-node-policy.js",
    "export:producer-node-and-npm-paths": "node scripts/ci-producer-toolchain.js",
    "install:producer-npm": "node scripts/qualification-process.js producer-npm",
    "install:producer-dependencies": "node scripts/qualification-process.js install",
    "install:consumer-npm": "node scripts/qualification-process.js consumer-npm",
    "freeze:release-manifest": "node scripts/release-prepare.js freeze-manifest",
    "emit:release-matrix": "node scripts/release-prepare.js resolve-matrix",
    "generate:source-dependency-evidence": "node scripts/release-inventory.js",
    "verify:release-codeql": "node scripts/release-security.js",
    "admit:release-evidence": "node scripts/release-evidence.js",
    "execute:release-action": "node scripts/release-command.js",
    "qualify:registry-package": "node scripts/qualify-registry.js",
    "collect:registry-evidence": "node scripts/release-registry-evidence.js",
    "pack:package-family": "node scripts/pack.js",
    "test:node-support": "node --test tests/node-support.test.js",
    "lint:javascript": "eslint src scripts tests .github/actions eslint.config.js",
    "run:prettier": "prettier --ignore-unknown . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:code": "npm run run:prettier -- --write",
    "check:code-formatting": "npm run run:prettier -- --check",
    "check:code-formatting-and-markdown": "npm run check:code-formatting && npm run check:markdown",
    "format:code-and-markdown": "npm run format:code && npm run format:markdown",
    "check:markdown": "markdown-quality check --diagnostic-display-level warning",
    "format:markdown": "markdown-quality format --diagnostic-display-level warning",
    "inspect:markdown": "markdown-quality inspect --json",
    "check:json": "node src/cli.js check --root .",
    "format:json": "node src/cli.js format --write --root .",
    "normalize:json": "node src/cli.js normalize --write --root .",
    "qualify:package": "node scripts/qualify-package.js",
    "test:native": "node --test --test-concurrency=1 tests/native/*.test.mjs",
    "build:native": "node scripts/build-native.js",
    "stage:native": "python native/stage.py",
    "check:workflow-contracts": "node scripts/check-workflows.js",
    "check:json:ndjson": "node src/cli.js check --root . --ndjson",
    "audit:dependencies": "node scripts/check-security.js",
    "sync:policy-inputs": "node scripts/project-policy-inputs.js --write",
    "check:policy-inputs": "node scripts/project-policy-inputs.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "ajv": "8.20.0",
    "prettier": "3.9.10"
  },
  "optionalDependencies": {
    "@hadden-industries/json-quality-linux-x64": "file:native/prebuilt/linux-x64",
    "@hadden-industries/json-quality-win32-x64": "file:native/prebuilt/win32-x64"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "readdir-glob": {
      "minimatch": "11.0.3"
    },
    "archiver-utils": {
      "glob": "14.0.3"
    }
  },
  "devDependencies": {
    "@actions/artifact": ">=6.3.1",
    "@eslint/js": ">=10.0.1",
    "@eslint/json": ">=2.1.1",
    "@hadden-industries/markdown-quality": ">=2.0.0",
    "@humanwhocodes/momoa": ">=3.3.13",
    "@types/node": ">=26.6.5",
    "dependency-cruiser": ">=18.7.0",
    "eslint": ">=10.13.0",
    "json-schema-to-typescript": ">=16.0.0",
    "publint": ">=0.3.25",
    "typescript": ">=7.0.2",
    "yaml": ">=2.9.1"
  }
}
