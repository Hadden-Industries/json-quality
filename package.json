{
  "name": "@hadden-industries/json-quality",
  "version": "1.0.0-rc.2",
  "description": "Strict JSON quality controls with complete discovery and guarded source repair",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.1 <13",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hadden-Industries/json-quality.git"
  },
  "homepage": "https://github.com/Hadden-Industries/json-quality#readme",
  "bugs": {
    "url": "https://github.com/Hadden-Industries/json-quality/issues"
  },
  "keywords": [
    "json",
    "formatter",
    "linter",
    "unicode",
    "nodejs",
    "cli"
  ],
  "bin": {
    "json-quality": "src/cli.js",
    "json-quality-qualify": "src/qualification-cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./eslint": {
      "types": "./types/eslint/index.d.ts",
      "import": "./src/eslint/index.js"
    },
    "./configuration-schema": "./schemas/configuration.schema.json",
    "./source-contract-schema": "./schemas/source-contract.schema.json",
    "./event-schema": "./schemas/event.schema.json",
    "./contract-cohort": "./schemas/contract-cohort.json"
  },
  "files": [
    "src/",
    "types/",
    "schemas/",
    "assets/native-packages.json",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "docs/consumer-guide.md",
    "docs/centralized-contracts.md",
    "docs/node-runtime-compatibility.md",
    "docs/architecture.md",
    "docs/ci-trust.md",
    "docs/resource-limits.md",
    "docs/native-protocol.md",
    "docs/README.md",
    "docs/api.md",
    "docs/cli.md",
    "docs/configuration.md",
    "docs/dependency-graph-and-tests.md",
    "docs/javascript-performance.md",
    "docs/markdown-quality.md",
    "docs/release-operations.md",
    "docs/rules/",
    "examples/"
  ],
  "types": "./types/index.d.ts",
  "scripts": {
    "graph:dependencies": "node scripts/dependency-graph.js",
    "check:focused": "node --test tests/contracts.test.js tests/identity.test.js tests/markdown-quality.test.js",
    "bench:check": "node scripts/bench-orchestration.js --workload check --files 30",
    "bench:format": "node scripts/bench-orchestration.js --workload format --files 50 --assert-batching",
    "check:perf": "npm run bench:check && npm run bench:format",
    "test": "node --test --test-concurrency=1 tests/*.test.js tests/native/*.test.mjs",
    "check:affected": "node scripts/affected-tests.js",
    "check:full": "npm run check:node && npm run check:ci && npm run check:resources && npm run check:architecture && npm run check:schemas && npm run check:types && npm run check:types:generated && npm run check:release && npm run check:package && npm run check:security && npm test && npm run lint && npm run format:check && npm run qualify:package && npm run check:json",
    "check:schemas": "node scripts/check-schemas.js",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "build:types": "node scripts/build-types.js",
    "check:types:generated": "node scripts/build-types.js --check",
    "check:package": "node scripts/check-package.js",
    "check:security": "node scripts/check-security.js",
    "check:resources": "node scripts/project-resource-limits.js",
    "sync:resources": "node scripts/project-resource-limits.js --write",
    "check:release": "node scripts/release-check.js",
    "check:architecture": "node scripts/check-architecture.js",
    "sync:node": "node scripts/project-node-support.js --write",
    "check:node": "node scripts/project-node-support.js --check",
    "matrix:node": "node scripts/node-matrix.js",
    "ci:node-policy": "node scripts/ci-node-policy.js",
    "ci:producer-toolchain": "node scripts/ci-producer-toolchain.js",
    "ci:setup-npm": "node scripts/qualification-process.js producer-npm",
    "ci:install": "node scripts/qualification-process.js install",
    "ci:consumer-npm": "node scripts/qualification-process.js consumer-npm",
    "release:prepare": "node scripts/release-prepare.js",
    "release:inventory": "node scripts/release-inventory.js",
    "release:security": "node scripts/release-security.js",
    "release:admit": "node scripts/release-evidence.js",
    "release:effect": "node scripts/release-effects.js",
    "release:registry": "node scripts/qualify-registry.js",
    "release:collect": "node scripts/release-registry-evidence.js",
    "pack:archive": "node scripts/pack.js",
    "test:node-policy": "node --test tests/node-support.test.js",
    "lint": "eslint src scripts tests .github/actions eslint.config.js",
    "prettier": "prettier --ignore-unknown . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:code": "npm run prettier -- --write",
    "format:code:check": "npm run prettier -- --check",
    "format:check": "npm run format:code:check && npm run check:markdown",
    "format": "npm run format:code && npm run format:markdown",
    "install:markdown": "npm --prefix tooling/markdown ci --ignore-scripts --engine-strict --no-audit --no-fund",
    "check:markdown": "npm --prefix tooling/markdown run --silent check --",
    "format:markdown": "npm --prefix tooling/markdown run --silent format --",
    "inspect:markdown": "npm --prefix tooling/markdown run --silent inspect --",
    "test:markdown": "node --test tests/markdown-quality.test.js",
    "check:json": "node src/cli.js check --root .",
    "inventory:json": "node src/cli.js check --root . --json",
    "lint:json": "node src/cli.js check --root .",
    "format:json": "node src/cli.js format --root .",
    "format:json:check": "node src/cli.js check --root .",
    "normalize:json": "node src/cli.js normalize --root .",
    "qualify:package": "node scripts/qualify-package.js",
    "test:native": "node --test --test-concurrency=1 tests/native/*.test.mjs",
    "native:build": "node scripts/build-native.js",
    "native:stage": "python native/stage.py",
    "check:ci": "node scripts/check-workflows.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "ajv": "8.20.0",
    "prettier": "3.9.10"
  },
  "optionalDependencies": {
    "@hadden-industries/json-quality-linux-x64": "file:native/prebuilt/linux-x64",
    "@hadden-industries/json-quality-win32-x64": "file:native/prebuilt/win32-x64"
  },
  "devDependencies": {
    "@actions/artifact": ">=6.3.1",
    "@eslint/js": ">=10.0.1",
    "@eslint/json": ">=2.1.1",
    "@humanwhocodes/momoa": ">=3.3.13",
    "@types/node": ">=26.6.5",
    "dependency-cruiser": ">=18.7.0",
    "eslint": ">=10.13.0",
    "json-schema-to-typescript": ">=16.0.0",
    "publint": ">=0.3.25",
    "typescript": ">=7.0.2",
    "yaml": ">=2.9.1"
  }
}
