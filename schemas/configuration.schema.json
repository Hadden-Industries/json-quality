{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaults",
    "exceptions"
  ],
  "properties": {
    "preserveSourcePresentation": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paths",
          "owner",
          "reason"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "capacityLimits": {
      "description": "Shared operation capacity ceilings. True enables configured/default capacities, false disables them, and an override object enables finite capacities with explicit values. Policy settings apply after admission; invocation capacityLimits controls bootstrap. Separate ESLint, cleanup, workflow and platform controls are outside this setting.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/definitions/capacityLimits"
        }
      ]
    },
    "schemaVersion": {
      "const": 2
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatContract",
        "allowFormatWrites",
        "normalization"
      ],
      "properties": {
        "formatContract": {
          "const": "prettier-json"
        },
        "allowFormatWrites": {
          "const": true
        },
        "normalization": {
          "const": "NFC"
        }
      }
    },
    "exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paths",
          "owner",
          "reason"
        ],
        "minProperties": 4,
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "exclude": {
            "const": true
          },
          "allowFormatWrites": {
            "const": false
          },
          "normalization": {
            "const": "preserve"
          },
          "preserveNfcValues": {
            "$ref": "#/definitions/nfcValues"
          },
          "allowEmptyKeys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*/$"
            }
          },
          "formatContract": {
            "enum": [
              "producer-json-body",
              "producer-json-indent",
              "producer-json-indent-body",
              "producer-json-compact",
              "producer-json-compact-body",
              "preserved-bytes"
            ]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "byteLength",
              "diagnostics"
            ],
            "properties": {
              "linkedDocuments": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "pointer",
                    "encoding",
                    "sha256",
                    "byteLength"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pointer": {
                      "type": "string",
                      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                    },
                    "encoding": {
                      "enum": [
                        "utf8",
                        "base64"
                      ]
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "byteLength": {
                      "$ref": "#/definitions/unsignedIntegerText"
                    }
                  }
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "$ref": "#/definitions/unsignedIntegerText"
              },
              "diagnostics": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/definitions/diagnosticIdentity"
                }
              }
            }
          }
        }
      }
    },
    "nativeSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "owner",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "owner": {
            "type": "string",
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "parameters": {
            "type": "object"
          },
          "minimumDocuments": {
            "type": "integer",
            "minimum": 0
          },
          "formatContract": {
            "enum": [
              "prettier-json",
              "producer-json-body",
              "producer-json-indent",
              "producer-json-indent-body",
              "producer-json-compact",
              "producer-json-compact-body"
            ]
          }
        }
      }
    },
    "runtimeControls": {
      "$ref": "#/definitions/runtimeControls"
    }
  },
  "definitions": {
    "runtimeControls": {
      "description": "Finite working controls for one execution. Admission bypass never disables these controls. The first native cohort admits one active checker under its aggregate target.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "managedMemoryTargetBytes": {
          "type": "integer",
          "minimum": 16777216,
          "maximum": 9007199254740991,
          "default": 33554432
        },
        "maxTemporaryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 2147483648
        },
        "maxNestingDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 128
        },
        "maxCheckTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "default": 120000
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "default": 1
        }
      }
    },
    "nfcValues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "sha256",
          "byteLength"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteLength": {
            "$ref": "#/definitions/positiveIntegerText"
          },
          "record": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "value"
            ],
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "capacityLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 50000
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 33554432
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 268435456
        },
        "maxLogicalDocuments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 100000
        },
        "maxRecords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 100000
        },
        "maxDiagnostics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 10000
        },
        "maxPolicyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 1048576
        },
        "maxGitOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 67108864
        },
        "maxToolOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 67108864
        },
        "maxToolTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 120000
        },
        "maxGitTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 120000
        },
        "maxAcquisitionTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 1200000
        },
        "maxCacheLookupTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 60000
        },
        "maxCacheOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 1048576
        },
        "maxRequestIdCharacters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 1024
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 50331648
        },
        "maxRequestPathCharacters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 32768
        }
      }
    },
    "unsignedIntegerText": {
      "description": "Canonical unsigned decimal integer, at most UINT64_MAX. Native storage and operation-specific ranges are checked independently.",
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "maxLength": 20
    },
    "positiveIntegerText": {
      "description": "Canonical positive decimal integer, at most UINT64_MAX. Native storage and operation-specific ranges are checked independently.",
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "maxLength": 20
    },
    "diagnosticIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "ruleId",
        "messageId",
        "line",
        "column",
        "severity",
        "endLine",
        "endColumn"
      ],
      "properties": {
        "phase": {
          "enum": [
            "bytes",
            "syntax",
            "lint",
            "framing"
          ]
        },
        "ruleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "$ref": "#/definitions/positiveIntegerText"
        },
        "column": {
          "$ref": "#/definitions/positiveIntegerText"
        },
        "endLine": {
          "$ref": "#/definitions/positiveIntegerText"
        },
        "endColumn": {
          "$ref": "#/definitions/positiveIntegerText"
        },
        "record": {
          "$ref": "#/definitions/positiveIntegerText"
        },
        "severity": {
          "const": "error"
        },
        "codePoint": {
          "type": "string",
          "pattern": "^U\\+[0-9A-F]{4,6}$"
        }
      }
    },
    "sourceExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byteLength",
        "diagnostics"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "$ref": "#/definitions/unsignedIntegerText"
        },
        "diagnostics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/diagnosticIdentity"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
