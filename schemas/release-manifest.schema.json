{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hadden-industries.github.io/json-quality/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "version",
    "source",
    "archive",
    "matrix",
    "policy",
    "policySha256",
    "toolchain"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "const": "@hadden-industries/json-quality"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "lockSha256",
        "clean"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/oid"
        },
        "tree": {
          "$ref": "#/$defs/oid"
        },
        "lockSha256": {
          "$ref": "#/$defs/sha"
        },
        "clean": {
          "const": true
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "size",
        "sha256",
        "integrity",
        "files"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*\\.tgz$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000000
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4000000
              },
              "sha256": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "node"
      ],
      "properties": {
        "os": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ubuntu-24.04",
              "windows-2025"
            ]
          }
        },
        "node": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        }
      }
    },
    "policy": {
      "type": "object"
    },
    "policySha256": {
      "$ref": "#/$defs/sha"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "npm"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "npm": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
