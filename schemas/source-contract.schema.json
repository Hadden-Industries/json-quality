{
  "title": "JSON Quality source contract, cohort 4",
  "description": "Selected complete source quality contract. Payload bytes travel separately as a backpressured stream. No compatibility with whole-document requests.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "enum": [
        "json",
        "jsonl"
      ]
    },
    "formatContract": {
      "enum": [
        "prettier-json",
        "producer-json-body",
        "producer-json-indent",
        "producer-json-indent-body",
        "producer-json-compact",
        "producer-json-compact-body",
        "preserved-bytes"
      ]
    },
    "normalization": {
      "enum": [
        "NFC",
        "preserve"
      ]
    },
    "allowEmptyKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:/(?:[^~/]|~[01])*)*/$"
      }
    },
    "allowSourceRewrites": {
      "const": false
    },
    "owner": {
      "type": "string",
      "pattern": "\\S"
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "nfcExemptStringValues": {
      "$ref": "https://github.com/Hadden-Industries/json-quality/schema/configuration/v4#/$defs/nfcExemptStringValuePins"
    },
    "expected": {
      "$ref": "https://github.com/Hadden-Industries/json-quality/schema/configuration/v4#/$defs/sourceExpectation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "nfcExemptStringValues": true
        },
        "required": [
          "nfcExemptStringValues"
        ]
      },
      "then": {
        "properties": {
          "allowSourceRewrites": true,
          "owner": true,
          "reason": true
        },
        "required": [
          "allowSourceRewrites",
          "owner",
          "reason"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hadden-Industries/json-quality/schema/source-contract/v4"
}
