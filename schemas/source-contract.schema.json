{
  "title": "JSON Quality source contract, cohort 2",
  "description": "Selected complete source quality contract. Payload bytes travel separately as a backpressured stream. No compatibility with whole-document requests.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "enum": ["json", "jsonl"]
    },
    "formatContract": {
      "enum": [
        "prettier-json",
        "producer-json-body",
        "producer-json-indent",
        "producer-json-indent-body",
        "producer-json-compact",
        "producer-json-compact-body",
        "preserved-bytes"
      ]
    },
    "normalization": {
      "enum": ["NFC", "preserve"]
    },
    "allowEmptyKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:/(?:[^~/]|~[01])*)*/$"
      }
    },
    "allowFormatWrites": {
      "const": false
    },
    "owner": {
      "type": "string",
      "pattern": "\\S"
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "preserveNfcValues": {
      "$ref": "https://github.com/Hadden-Industries/json-quality/schema/configuration/v3#/$defs/nfcValues"
    },
    "expected": {
      "$ref": "https://github.com/Hadden-Industries/json-quality/schema/configuration/v3#/$defs/sourceExpectation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "preserveNfcValues": true
        },
        "required": ["preserveNfcValues"]
      },
      "then": {
        "properties": {
          "allowFormatWrites": true,
          "owner": true,
          "reason": true
        },
        "required": ["allowFormatWrites", "owner", "reason"]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hadden-Industries/json-quality/schema/source-contract/v3"
}
